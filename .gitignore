.claude/*
!.claude/skills/

# Configuração local (chaves, paths privados)
.env

# OS
.DS_Store
Thumbs.db

# Arquivos com nomes corrompidos (artefatos de sessão anterior).
# Os colchetes são escapados com `\[` porque `[` em gitignore inicia
# uma classe de caracteres — sem escape o pattern não casa o nome real.
1])
None
float
str
Tuple\[float
Tuple\[int
CaseResult

# Backup local do código da arquitetura antiga (não versionado)
Código Velho/

# Trabalho do usuário no root do repo — datasets, projetos FaceAudit,
# notebooks e documentação local. Não pertencem ao repo do código.
Projeto*/
Documentação/
gráficos/
notebooks/
*.ipynb
*.puml

# Artefatos avulsos no root: PDFs/PNGs/JPGs gerados pela aplicação ou
# por scripts pontuais (laudos, capturas, plots, diagramas).
/*.pdf
/*.png
/*.PNG
/*.jpg
/*.JPG
/*.jpeg

# Definitions órfãs soltas no root (devem viver dentro de pasta de
# projeto FaceAudit, nunca diretamente no root do repo).
/[0-9a-f]*-*-*-*-*_definition.json

# Notas/propostas avulsas no root usadas pra trabalho externo.
ForensicFace_Batch_API_Proposal.md

# Referência ao código antigo (mantido localmente, não no repo).
codigo_antigo.txt

# Documento companion gerado junto com os .puml de arquitetura C4
# (regenerável a partir das próprias fontes .puml).
faceaudit_strategy_engine_c4_packages.md

# Script de teste local pra CV diagnóstico do calibrador (depende do
# `Projeto 1 - PLDA/` que já está ignorado via `Projeto*/`).
test_cv_comparativo.py

# Projetos FaceAudit ativos (datasets primários ~40MB+ e outputs grandes).
# A estrutura .fa é regenerada pelo controller; datasets primários ficam
# fora do versionamento porque vêm de corpora ou geradores próprios.
projects/

# Scripts auxiliares pessoais usados nas sessões de análise (batch runner,
# K-sweep, comparações ad-hoc). Não fazem parte do produto.
scripts/

# Caches e artefatos do experimento Teste Tipicidade (modelos cacheados,
# fingerprints intermediários, JSONs por batch — regenerados pelo design).
experiments/Teste Tipicidade/_frozen/
experiments/Teste Tipicidade/_cache/
experiments/Teste Tipicidade/results/
experiments/Teste Tipicidade/figures/
experiments/Teste Tipicidade/*.json
experiments/Teste Tipicidade/*.log
experiments/Teste Tipicidade/*.csv
experiments/Teste Tipicidade/*.parquet
